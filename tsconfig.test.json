{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "next"
    ],
    "rootDir": ".",
    "outDir": ".test-build",
    "noEmit": false,
    "incremental": false,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "tests/unit/**/*.ts",
    "tests/integration/**/*.ts"
  ]
}
