# WorkProof configuration template. Copy to .env.local (git-ignored) and fill in.
# Never commit real values. Only NEXT_PUBLIC_* variables reach the browser, so
# no secret may use that prefix.

# --- Supabase -------------------------------------------------------------
# Project URL (https origin). Not secret.
NEXT_PUBLIC_SUPABASE_URL=
# Server-only secret key (starts with sb_secret_). Bypasses RLS: keep it private.
SUPABASE_SECRET_KEY=

# --- Owner sign-in (server-only) ----------------------------------------------
# At least 12 characters; use a long passphrase.
WORKPROOF_OWNER_PASSCODE=
# At least 32 random characters, different from the passcode. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WORKPROOF_SESSION_SECRET=
# Optional. Session lifetime in minutes (default 120, clamped to 5-720).
WORKPROOF_SESSION_TTL_MINUTES=

# --- Application ----------------------------------------------------------
# Public origin used in confirmation links. Required in production (https).
# Defaults to http://localhost:3000 in development.
WORKPROOF_APP_URL=
# Optional. Name shown to clients on the confirmation page.
WORKPROOF_OWNER_NAME=
# Optional. Set to "true" only behind a proxy you control that overwrites
# X-Forwarded-For. (Trusted automatically on Vercel.) Enables per-client limits.
WORKPROOF_TRUST_PROXY_HEADERS=
